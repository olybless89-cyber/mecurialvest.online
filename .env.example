FROM_EMAIL=NexBank <noreply@yourdomain.com>
FRONTEND_URL=https://your-app.netlify.app

# ---- FRONTEND (Netlify) ----
NEXT_PUBLIC_API_URL=https://your-render-app.onrender.com
