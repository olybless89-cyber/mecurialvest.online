{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/business", "destination": "/business.html" },
    { "source": "/personal", "destination": "/personal.html" },
    { "source": "/cards", "destination": "/cards.html" },
    { "source": "/loans", "destination": "/loans.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/register", "destination": "/register.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/apps", "destination": "/apps.html" },
    { "source": "/privacy-policy", "destination": "/privacy-policy.html" },
    { "source": "/terms-of-service", "destination": "/terms-of-service.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
